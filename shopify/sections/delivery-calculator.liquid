{%- comment -%}
  Customer delivery calculator for the Nicks Timber Shopify store.
  Same rate card as the team Delivery Rates page: a flat charge per distance band, priced by the mile past
  the last band, and free delivery over an order value that rises with distance.
  Rates are edited in the theme editor (Charge band and Free delivery blocks), not in this file.
  Postcodes and place names are looked up with postcodes.io (free, Ordnance Survey and ONS data).
{%- endcomment -%}

{%- liquid
  assign charge_blocks = section.blocks | where: 'type', 'charge'
  assign free_blocks = section.blocks | where: 'type', 'free'
-%}

<div class="ntdc" id="ntdc-{{ section.id }}" style="--ntdc-accent: {{ section.settings.accent }};">
  <div class="ntdc__inner page-width">
    {%- if section.settings.heading != blank -%}<h2 class="ntdc__title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<div class="ntdc__intro">{{ section.settings.intro }}</div>{%- endif -%}

    <form class="ntdc__form" novalidate>
      <label class="ntdc__label" for="ntdc-q-{{ section.id }}">Delivery postcode or town</label>
      <div class="ntdc__row">
        <input class="ntdc__input" id="ntdc-q-{{ section.id }}" name="q" type="text" autocomplete="postal-code"
          placeholder="e.g. GL5 3AB or Stroud" enterkeyhint="search" required>
        <button class="ntdc__btn button" type="submit">Check delivery</button>
      </div>
      <ul class="ntdc__choices" hidden></ul>
    </form>

    <div class="ntdc__result" aria-live="polite" hidden></div>

    {%- if section.settings.show_table -%}
      <details class="ntdc__table">
        <summary>See all delivery prices</summary>
        <div class="ntdc__tablewrap"><table></table></div>
      </details>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}<div class="ntdc__foot">{{ section.settings.footnote }}</div>{%- endif -%}
  </div>

  <script type="application/json" class="ntdc__config">
    {
      "yard": [{{ section.settings.yard_lat | default: "51.8495" | plus: 0 }}, {{ section.settings.yard_lon | default: "-2.2565" | plus: 0 }}],
      "roadFactor": {{ section.settings.road_factor | default: 1.2 }},
      "vat": {{ section.settings.vat | default: 20 }},
      "pricesIncVat": {% if section.settings.prices_inc_vat %}true{% else %}false{% endif %},
      "roundTo": {{ section.settings.round_to | default: 5 }},
      "minCharge": {{ section.settings.min_charge | default: 0 }},
      "beyondBase": {{ section.settings.beyond_base | default: "0" | plus: 0 }},
      "beyondPerMile": {{ section.settings.beyond_per_mile | default: "0" | plus: 0 }},
      "maxMiles": {{ section.settings.max_miles | default: 0 }},
      "freeBeyond": {{ section.settings.free_beyond | default: 0 }},
      "phone": {{ section.settings.phone | json }},
      "email": {{ section.settings.email | json }},
      "cartTotal": {{ cart.total_price | divided_by: 100.0 }},
      "charges": [{% for b in charge_blocks %}[{{ b.settings.up_to | default: 0 }}, {{ b.settings.price | default: 0 }}]{% unless forloop.last %},{% endunless %}{% endfor %}],
      "free": [{% for b in free_blocks %}[{{ b.settings.up_to | default: 0 }}, {{ b.settings.min_order | default: 0 }}]{% unless forloop.last %},{% endunless %}{% endfor %}]
    }
  </script>
</div>

<style>
  #ntdc-{{ section.id }} { padding-block: {{ section.settings.padding }}px; }
  .ntdc__inner { max-width: 720px; margin-inline: auto; display: grid; gap: 16px; }
  .ntdc__inner > * { min-width: 0; }
  .ntdc [hidden] { display: none !important; }
  .ntdc__title { margin: 0; }
  .ntdc__intro p, .ntdc__foot p { margin: 0; }
  .ntdc__foot { font-size: .875em; opacity: .75; }
  .ntdc__form { display: grid; gap: 6px; position: relative; }
  .ntdc__label { font-weight: 600; }
  .ntdc__row { display: flex; gap: 8px; flex-wrap: wrap; }
  .ntdc__input { flex: 1 1 220px; min-width: 0; font: inherit; font-size: 16px; padding: 12px 14px;
    border: 1px solid rgba(0,0,0,.25); border-radius: 6px; background: #fff; color: #1a1a1a; }
  .ntdc__input:focus-visible { outline: 2px solid var(--ntdc-accent); outline-offset: 1px; }
  .ntdc__btn { flex: 0 0 auto; }
  .ntdc__choices { list-style: none; margin: 4px 0 0; padding: 4px; border: 1px solid rgba(0,0,0,.15); border-radius: 6px;
    background: #fff; color: #1a1a1a; display: grid; gap: 2px; max-height: 260px; overflow-y: auto; }
  .ntdc__choices button { all: unset; box-sizing: border-box; display: block; width: 100%; padding: 8px 10px; border-radius: 4px; cursor: pointer; }
  .ntdc__choices button:hover, .ntdc__choices button:focus-visible { background: rgba(0,0,0,.06); }
  .ntdc__choices small { opacity: .7; }
  .ntdc__result { border: 1px solid rgba(0,0,0,.12); border-left: 4px solid var(--ntdc-accent); border-radius: 6px; padding: 16px 18px; display: grid; gap: 8px; }
  .ntdc__where { font-size: .95em; opacity: .8; margin: 0; }
  .ntdc__price { font-size: 2em; font-weight: 700; line-height: 1.1; color: var(--ntdc-accent); margin: 0; }
  .ntdc__price small { display: block; margin-top: 4px; font-size: .45em; font-weight: 400; color: inherit; opacity: .8; }
  .ntdc__note { margin: 0; }
  .ntdc__bar { height: 8px; border-radius: 4px; background: rgba(0,0,0,.1); overflow: hidden; }
  .ntdc__bar i { display: block; height: 100%; background: var(--ntdc-accent); }
  .ntdc__err { color: #a4332a; margin: 0; }
  .ntdc__table summary { cursor: pointer; font-weight: 600; }
  .ntdc__tablewrap { overflow-x: auto; margin-top: 10px; }
  .ntdc__table table { width: 100%; border-collapse: collapse; font-size: .95em; }
  .ntdc__table th, .ntdc__table td { padding: 8px 10px; border-bottom: 1px solid rgba(0,0,0,.1); text-align: right; white-space: nowrap; }
  .ntdc__table th:first-child, .ntdc__table td:first-child { text-align: left; }
  .ntdc__table th { white-space: normal; vertical-align: bottom; }
  @media (max-width: 480px) { .ntdc__table th:nth-child(3), .ntdc__table td:nth-child(3) { display: none; } .ntdc__table th, .ntdc__table td { padding-inline: 6px; } }
  .ntdc__table tr.is-here td { background: color-mix(in srgb, var(--ntdc-accent) 12%, transparent); }
</style>

<script>
(function () {
  const root = document.getElementById("ntdc-{{ section.id }}");
  if (!root || root.dataset.ready) return;
  root.dataset.ready = "1";
  const C = JSON.parse(root.querySelector(".ntdc__config").textContent);
  const STORE = "ntdc-place";
  const API = "https://api.postcodes.io";
  const form = root.querySelector(".ntdc__form"), input = form.querySelector("input"), choices = root.querySelector(".ntdc__choices");
  const out = root.querySelector(".ntdc__result"), table = root.querySelector(".ntdc__table table");
  const vat = 1 + C.vat / 100;
  const charges = C.charges.filter(c => c[0] > 0).sort((a, b) => a[0] - b[0]);
  const freeBands = C.free.filter(f => f[0] > 0).sort((a, b) => a[0] - b[0]);
  const lastEdge = charges.length ? charges[charges.length - 1][0] : 0;
  const money = n => "£" + n.toLocaleString("en-GB", { minimumFractionDigits: n % 1 ? 2 : 0, maximumFractionDigits: 2 });
  const esc = s => String(s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
  let cartEx = (C.pricesIncVat ? C.cartTotal / vat : C.cartTotal);
  let last = null;

  // Road miles from the yard: straight-line distance × the road factor, to the nearest half mile.
  function roadMiles(lat, lon) {
    const r = x => x * Math.PI / 180, [ya, yo] = C.yard, dLa = r(lat - ya), dLo = r(lon - yo);
    const a = Math.sin(dLa / 2) ** 2 + Math.cos(r(ya)) * Math.cos(r(lat)) * Math.sin(dLo / 2) ** 2;
    return Math.round(3958.8 * 2 * Math.asin(Math.sqrt(a)) * C.roadFactor * 2) / 2;
  }
  // Charge ex VAT: the flat price of the band, or by the mile past the last band. null = we don't deliver there.
  function chargeFor(miles) {
    if (C.maxMiles > 0 && miles > C.maxMiles) return null;
    const band = charges.find(c => miles <= c[0]);
    if (band) return { price: Math.max(band[1], C.minCharge), from: prevEdge(band[0]), to: band[0] };
    if (!(C.beyondPerMile > 0)) return null;
    const raw = C.beyondBase + miles * C.beyondPerMile, step = C.roundTo > 0 ? C.roundTo : 1;
    return { price: Math.max(Math.ceil(raw / step - 1e-9) * step, C.minCharge), from: lastEdge, to: Infinity };
  }
  function prevEdge(to) { let p = 0; for (const c of charges) { if (c[0] >= to) break; p = c[0]; } return p; }
  // Minimum order (ex VAT) for free delivery at this distance; null = no free delivery that far.
  function freeOver(miles) {
    const b = freeBands.find(f => miles <= f[0]);
    if (b) return b[1];
    return C.freeBeyond > 0 ? C.freeBeyond : null;
  }

  function show(place) {
    last = place;
    const miles = roadMiles(place.lat, place.lon), c = chargeFor(miles), over = freeOver(miles);
    let html = `<p class="ntdc__where">Delivering to <b>${esc(place.label)}</b>, about ${miles} miles from our yard in Gloucester.</p>`;
    if (!c) {
      html += `<p class="ntdc__note">That's further than our standard delivery area. Please ${contact()} and we'll quote for it.</p>`;
    } else {
      const free = over != null && cartEx >= over;
      html += free
        ? `<p class="ntdc__price">Free delivery <small>normally ${money(c.price)} + VAT</small></p>`
        : `<p class="ntdc__price">${money(c.price)} <small>+ VAT (${money(c.price * vat)} inc VAT)</small></p>`;
      if (over == null) {
        html += `<p class="ntdc__note">Free delivery doesn't reach this far, but the price above is fixed whatever you order.</p>`;
      } else if (free) {
        html += `<p class="ntdc__note">Your basket of ${money(cartEx)} + VAT qualifies for free delivery to this address.</p>`;
      } else {
        const need = over - cartEx;
        html += `<p class="ntdc__note">Free delivery here on orders of <b>${money(over)} + VAT</b> or more.` +
          (cartEx > 0 ? ` Your basket is ${money(cartEx)} + VAT, so add <b>${money(need)}</b> more to qualify.` : "") + `</p>`;
        if (cartEx > 0) html += `<div class="ntdc__bar" role="img" aria-label="${Math.round(cartEx / over * 100)}% of the way to free delivery"><i style="width:${Math.min(100, cartEx / over * 100)}%"></i></div>`;
      }
    }
    out.innerHTML = html;
    out.hidden = false;
    renderTable(miles);
    try { localStorage.setItem(STORE, JSON.stringify(place)); } catch (e) {}
  }
  function contact() {
    const ways = [];
    if (C.phone) ways.push(`call us on <a href="tel:${esc(C.phone.replace(/\s/g, ""))}">${esc(C.phone)}</a>`);
    if (C.email) ways.push(`email <a href="mailto:${esc(C.email)}">${esc(C.email)}</a>`);
    return ways.length ? ways.join(" or ") : "get in touch";
  }
  function fail(msg) { out.innerHTML = `<p class="ntdc__err">${msg}</p>`; out.hidden = false; }

  function renderTable(here) {
    if (!table) return;
    const rows = charges.map(c => ({ from: prevEdge(c[0]), to: c[0], price: Math.max(c[1], C.minCharge) }));
    if (C.beyondPerMile > 0 && !(C.maxMiles > 0 && C.maxMiles <= lastEdge)) rows.push({ from: lastEdge, to: C.maxMiles > 0 ? C.maxMiles : Infinity, beyond: true });
    table.innerHTML = `<thead><tr><th>Distance from our yard</th><th>Delivery + VAT</th><th>Inc VAT</th><th>Free on orders from</th></tr></thead><tbody>` +
      rows.map(r => {
        const label = r.to === Infinity ? `Over ${r.from} miles` : `${r.from}–${r.to} miles`;
        const p = r.beyond ? chargeFor(r.from + 1) : r;
        const over = freeOver(r.beyond ? r.from + 1 : r.to);
        const isHere = here != null && here > r.from && (here <= r.to || r.to === Infinity) || (here === 0 && r.from === 0);
        return `<tr class="${isHere ? "is-here" : ""}"><td>${label}</td><td>${r.beyond ? "From " : ""}${p ? money(p.price) : "–"}</td><td>${p ? (r.beyond ? "From " : "") + money(p.price * vat) : "–"}</td><td>${over != null ? money(over) + " + VAT" : "–"}</td></tr>`;
      }).join("") + `</tbody>`;
  }

  // Postcode (full or district) first, then place names.
  async function lookup(raw) {
    const q = raw.trim(), pc = q.toUpperCase().replace(/\s+/g, "");
    choices.hidden = true;
    if (q.length < 2) return fail("Type a postcode or the name of your town or village.");
    out.innerHTML = `<p class="ntdc__where">Looking that up…</p>`; out.hidden = false;
    try {
      if (/^[A-Z]{1,2}\d[A-Z\d]?\d[A-Z]{2}$/.test(pc)) {
        const r = await fetch(`${API}/postcodes/${pc}`);
        if (r.ok) { const j = (await r.json()).result; return show({ label: j.postcode, lat: j.latitude, lon: j.longitude }); }
        // Not a live postcode (new build, typo): fall back to the district.
        const d = await fetch(`${API}/outcodes/${pc.slice(0, -3)}`);
        if (d.ok) { const j = (await d.json()).result; return show({ label: `${pc.slice(0, -3)} ${pc.slice(-3)} (area ${j.outcode})`, lat: j.latitude, lon: j.longitude }); }
        return fail("We couldn't find that postcode. Check it, or try your town instead.");
      }
      if (/^[A-Z]{1,2}\d[A-Z\d]?$/.test(pc)) {
        const d = await fetch(`${API}/outcodes/${pc}`);
        if (d.ok) { const j = (await d.json()).result; return show({ label: `${j.outcode} area`, lat: j.latitude, lon: j.longitude }); }
      }
      const r = await fetch(`${API}/places?q=${encodeURIComponent(q)}&limit=8`);
      const list = r.ok ? ((await r.json()).result || []).filter(p => p.latitude != null) : [];
      if (!list.length) return fail("We couldn't find that place. Try your postcode instead.");
      const area = p => [p.county_unitary, p.district_borough, p.region].find(a => a && a !== p.name_1) || "";
      const opts = list.map(p => ({ label: [p.name_1, area(p)].filter(Boolean).join(", "), lat: p.latitude, lon: p.longitude }));
      const exact = opts.filter((o, i) => list[i].name_1.toLowerCase() === q.toLowerCase());
      if (opts.length === 1 || exact.length === 1) return show(exact[0] || opts[0]);
      out.hidden = true;
      choices.innerHTML = opts.map((o, i) => `<li><button type="button" data-i="${i}">${esc(list[i].name_1)} <small>${esc(area(list[i]))}</small></button></li>`).join("");
      choices.hidden = false;
      choices.querySelectorAll("button").forEach(b => b.addEventListener("click", () => { choices.hidden = true; input.value = opts[+b.dataset.i].label; show(opts[+b.dataset.i]); }));
      choices.querySelector("button").focus();
    } catch (e) {
      fail(`We couldn't check that just now. Please try again, or ${contact()} for a delivery price.`);
    }
  }

  form.addEventListener("submit", e => { e.preventDefault(); lookup(input.value); });

  // The basket can change without a page load (cart drawer), so refresh its total when the page regains focus.
  async function refreshCart() {
    try {
      const j = await (await fetch("{{ routes.cart_url }}.js", { headers: { Accept: "application/json" } })).json();
      const t = j.total_price / 100;
      cartEx = C.pricesIncVat ? t / vat : t;
      if (last) show(last);
    } catch (e) {}
  }
  document.addEventListener("visibilitychange", () => { if (!document.hidden) refreshCart(); });
  document.addEventListener("cart:updated", refreshCart);
  document.addEventListener("on:cart:after-merge", refreshCart);

  renderTable(null);
  try {
    const p = JSON.parse(localStorage.getItem(STORE) || "null");
    if (p && isFinite(p.lat) && isFinite(p.lon)) { input.value = p.label; show(p); }
  } catch (e) {}
  refreshCart();
})();
</script>

{% schema %}
{
  "name": "Delivery calculator",
  "tag": "section",
  "class": "section-delivery-calculator",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How much is delivery?" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Enter your postcode to see the delivery price on our own lorry from our yard in Gloucester, and how much you need to order for free delivery.</p>" },
    { "type": "richtext", "id": "footnote", "label": "Small print", "default": "<p>Distances are estimated by road from the postcode, so the price can change slightly once we confirm your exact address.</p>" },
    { "type": "text", "id": "phone", "label": "Phone number for quotes outside the area" },
    { "type": "text", "id": "email", "label": "Email for quotes outside the area", "default": "enquiries@nickstimber.co.uk" },
    { "type": "checkbox", "id": "show_table", "label": "Show the full price list", "default": true },
    { "type": "color", "id": "accent", "label": "Accent colour", "default": "#2f5d50" },
    { "type": "range", "id": "padding", "label": "Top and bottom spacing", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },

    { "type": "header", "content": "Pricing" },
    { "type": "paragraph", "content": "Add one Charge band block per distance band, and one Free delivery block per free-delivery band. Prices and order values are £ ex VAT." },
    { "type": "number", "id": "min_charge", "label": "Minimum charge (£ ex VAT)", "default": 25 },
    { "type": "text", "id": "beyond_base", "label": "Past the last charge band: fixed part (£ ex VAT)", "default": "11.58" },
    { "type": "text", "id": "beyond_per_mile", "label": "Past the last charge band: £ per mile (blank = ask customer to call)", "default": "1.83" },
    { "type": "select", "id": "round_to", "label": "Round per-mile prices up to", "default": "5", "options": [ { "value": "1", "label": "£1" }, { "value": "5", "label": "£5" }, { "value": "10", "label": "£10" } ] },
    { "type": "number", "id": "max_miles", "label": "Furthest we deliver (miles, blank = no limit)" },
    { "type": "number", "id": "free_beyond", "label": "Past the last free band: free on orders from (£ ex VAT, blank = none)", "default": 1500 },
    { "type": "checkbox", "id": "prices_inc_vat", "label": "Shop prices include VAT", "info": "Leave off: this store shows prices ex VAT.", "default": false },
    { "type": "number", "id": "vat", "label": "VAT rate (%)", "default": 20 },

    { "type": "header", "content": "Distance" },
    { "type": "text", "id": "yard_lat", "label": "Yard latitude", "default": "51.8495" },
    { "type": "text", "id": "yard_lon", "label": "Yard longitude", "default": "-2.2565" },
    { "type": "number", "id": "road_factor", "label": "Road miles factor (× straight-line miles)", "default": 1.2 }
  ],
  "blocks": [
    {
      "type": "charge",
      "name": "Charge band",
      "limit": 30,
      "settings": [
        { "type": "number", "id": "up_to", "label": "Up to (miles from the yard)" },
        { "type": "number", "id": "price", "label": "Charge (£ ex VAT)" }
      ]
    },
    {
      "type": "free",
      "name": "Free delivery",
      "limit": 20,
      "settings": [
        { "type": "number", "id": "up_to", "label": "Up to (miles from the yard)" },
        { "type": "number", "id": "min_order", "label": "Free on orders from (£ ex VAT)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Delivery calculator",
      "blocks": [
        { "type": "charge", "settings": { "up_to": 5, "price": 25 } },
        { "type": "charge", "settings": { "up_to": 10, "price": 30 } },
        { "type": "charge", "settings": { "up_to": 15, "price": 40 } },
        { "type": "charge", "settings": { "up_to": 20, "price": 50 } },
        { "type": "charge", "settings": { "up_to": 30, "price": 70 } },
        { "type": "charge", "settings": { "up_to": 40, "price": 85 } },
        { "type": "charge", "settings": { "up_to": 50, "price": 105 } },
        { "type": "charge", "settings": { "up_to": 65, "price": 135 } },
        { "type": "charge", "settings": { "up_to": 80, "price": 160 } },
        { "type": "charge", "settings": { "up_to": 100, "price": 195 } },
        { "type": "free", "settings": { "up_to": 5, "min_order": 300 } },
        { "type": "free", "settings": { "up_to": 20, "min_order": 500 } },
        { "type": "free", "settings": { "up_to": 30, "min_order": 750 } },
        { "type": "free", "settings": { "up_to": 50, "min_order": 1000 } },
        { "type": "free", "settings": { "up_to": 100, "min_order": 1250 } }
      ]
    }
  ]
}
{% endschema %}
